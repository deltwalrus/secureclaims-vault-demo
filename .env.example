# Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=dev-root-token

# Database connection (host/port/name only — credentials come from Vault)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claims
DB_SSL=disable   # set to "require" for TLS (e.g. RDS)

# Optional overrides (defaults match vault-setup/setup.sh)
# VAULT_TRANSIT_KEY=claims-pii
# VAULT_DB_ROLE=claims-app-role
# VAULT_KV_MOUNT=secret

# AWS IAM auth (uncomment if running on AWS instead of using VAULT_TOKEN)
# VAULT_AWS_ROLE=claims-app
# VAULT_AWS_AUTH_PATH=aws
